// ============================================================
// DASHBOARD
// ============================================================
function getDashboard(days) {
  const sheet = SpreadsheetApp
    .getActiveSpreadsheet()
    .getSheetByName(SHEET_NAME);

  const data = sheet.getDataRange().getValues();

  const cutoff = new Date(
    new Date().getTime() -
    days * 86400000
  );

  const rangeData = {};

  Object.keys(RANGE_CONFIG).forEach(id => {
    rangeData[id] = {
      id,
      name: RANGE_CONFIG[id].name,
      total: 0,
      checkoutTotal: 0,
      active: [],
      positions: [],
      rows: RANGE_CONFIG[id].rows,
      ammo: RANGE_CONFIG[id].ammo
    };
  });

  getOpenSessions().forEach(session => {
    if (!rangeData[session.range]) return;

    rangeData[session.range]
      .active.push(session.member);

    if (session.positions) {
      session.positions
        .split(",")
        .forEach(position => {
          if (position) {
            rangeData[session.range]
              .positions.push(position);
          }
        });
    }
  });

  for (let i = 1; i < data.length; i++) {
    const date = new Date(data[i][0]);
    const range = String(
      data[i][1] || ""
    ).toLowerCase();

    const action = String(
      data[i][5] || ""
    );

    if (!rangeData[range]) continue;
    if (date < cutoff) continue;

    if (action === "IN") {
      rangeData[range].total++;
    }

    if (action === "OUT") {
      rangeData[range].checkoutTotal++;
    }
  }

  const ranges = Object
    .values(rangeData)
    .filter(range =>
      range.total > 0 ||
      range.checkoutTotal > 0 ||
      range.active.length > 0
    );

  return {
    ranges,
    config: RANGE_CONFIG
  };
}

