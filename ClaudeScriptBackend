// ============================================================
// RANGE HOURS / AUTOMATIC CHECKOUTS
// ============================================================
function getRangeStatus(rangeId, now) {
  const range = String(rangeId || "").toLowerCase().trim();
  if (!RANGE_CONFIG[range]) return { valid: false, open: false, error: "Invalid range" };

  const current = now instanceof Date ? now : new Date();
  if (EXEMPT_RANGE_IDS.includes(range)) {
    return { valid: true, open: true, exempt: true, range, rangeName: getRangeName(range) };
  }

  const localParts = getLocalDateTimeParts(current);
  if (localParts.hour < NORMAL_OPEN_HOUR) {
    return { valid: true, open: false, range, rangeName: getRangeName(range), reason: "BEFORE_OPEN" };
  }

  const sunset = calculateSunsetUtc(localParts.year, localParts.month, localParts.day, RANGE_LATITUDE, RANGE_LONGITUDE);
  const closeTime = new Date(sunset.getTime() + SUNSET_GRACE_MINUTES * 60000);

  if (current.getTime() >= closeTime.getTime()) {
    return { valid: true, open: false, range, rangeName: getRangeName(range), reason: "AFTER_CLOSE", sunset: sunset.toISOString(), closesAt: closeTime.toISOString() };
  }

  return { valid: true, open: true, range, rangeName: getRangeName(range), sunset: sunset.toISOString(), closesAt: closeTime.toISOString() };
}

function getLocalDateTimeParts(date) {
  const parts = Utilities.formatDate(date, RANGE_TIME_ZONE, "yyyy,MM,dd,HH,mm,ss").split(",").map(Number);
  return { year: parts[0], month: parts[1], day: parts[2], hour: parts[3], minute: parts[4], second: parts[5] };
}

function calculateSunsetUtc(year, month, day, latitude, longitude) {
  const date = new Date(Date.UTC(year, month - 1, day));
  const start = new Date(Date.UTC(year, 0, 0));
  const dayOfYear = Math.floor((date.getTime() - start.getTime()) / 86400000);
  const lngHour = longitude / 15;
  const t = dayOfYear + ((18 - lngHour) / 24);
  const M = (0.9856 * t) - 3.289;
  let L = M + (1.916 * Math.sin(toRadians(M))) + (0.020 * Math.sin(toRadians(2 * M))) + 282.634;
  L = normalizeDegrees(L);
  let RA = toDegrees(Math.atan(0.91764 * Math.tan(toRadians(L))));
  RA = normalizeDegrees(RA);
  RA += (Math.floor(L / 90) * 90) - (Math.floor(RA / 90) * 90);
  RA /= 15;
  const sinDec = 0.39782 * Math.sin(toRadians(L));
  const cosDec = Math.cos(Math.asin(sinDec));
  const cosH = (Math.cos(toRadians(90.833)) - (sinDec * Math.sin(toRadians(latitude)))) / (cosDec * Math.cos(toRadians(latitude)));
  if (cosH < -1 || cosH > 1) throw new Error("Sunset could not be calculated for this date.");
  const H = toDegrees(Math.acos(cosH)) / 15;
  const T = H + RA - (0.06571 * t) - 6.622;
  let UT = T - lngHour;
  while (UT < 0) UT += 24;
  while (UT >= 24) UT -= 24;

  let ms = Date.UTC(year, month - 1, day) + Math.round(UT * 3600000);

  // FIX: UT above is a time-of-day in 0-24h, but in summer the real sunset
  // for this longitude falls after 00:00 UTC, i.e. on the NEXT UTC day.
  // Sunset here is always evening local time (~21:00-00:30 UTC), so a UT
  // before noon belongs to the following UTC day.
  if (UT < 12) ms += 86400000;

  return new Date(ms);
}

function normalizeDegrees(value) { let result = value % 360; if (result < 0) result += 360; return result; }
function toRadians(degrees) { return degrees * Math.PI / 180; }
function toDegrees(radians) { return radians * 180 / Math.PI; }

function enforceRangeRules() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return { success: false, error: "Could not acquire lock" };
  try {
    const sessions = getOpenSessions();
    const now = new Date();
    let closed = 0;
    sessions.forEach(session => {
      if (shouldAutomaticallyCloseSession(session, now)) {
        autoCloseSession(session, now, getAutomaticCheckoutReason(session));
        closed++;
      }
    });
    return { success: true, closed };
  } finally { lock.releaseLock(); }
}

function enforceRangeRulesForRange(rangeId) {
  const range = String(rangeId || "").toLowerCase().trim();
  if (!RANGE_CONFIG[range]) return { success: false, error: "Invalid range" };
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return { success: false, error: "Could not acquire lock" };
  try {
    const sessions = getOpenSessions().filter(session => session.range === range);
    const now = new Date();
    let closed = 0;
    sessions.forEach(session => {
      if (shouldAutomaticallyCloseSession(session, now)) {
        autoCloseSession(session, now, getAutomaticCheckoutReason(session));
        closed++;
      }
    });
    return { success: true, closed };
  } finally { lock.releaseLock(); }
}

function shouldAutomaticallyCloseSession(session, now) {
  if (EXEMPT_RANGE_IDS.includes(session.range)) {
    return (now.getTime() - new Date(session.timestamp).getTime()) >= EXEMPT_MAX_SESSION_HOURS * 3600000;
  }
  return !getRangeStatus(session.range, now).open;
}

function getAutomaticCheckoutReason(session) {
  return EXEMPT_RANGE_IDS.includes(session.range) ? "SIX_HOUR_LIMIT" : "RANGE_CLOSED";
}

function autoCloseSession(session, now, reason) {
  appendCheckoutRow(session.range, session.member, session.session, "", "");
  const sheet = ensureSheetWithHeaders(FORGOTTEN_SHEET, [
    "EventID", "MemberID", "Range", "CheckInTime", "AutoCheckoutTime", "Reason", "Acknowledged", "AcknowledgedAt"
  ]);
  sheet.appendRow([Utilities.getUuid(), session.member, session.range, new Date(session.timestamp), now, reason, false, ""]);
}

