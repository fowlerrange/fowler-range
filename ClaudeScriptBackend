// ============================================================
// GET ROUTER
// ============================================================
function doGet(e) {
  try {
    return routeGet(e);
  } catch (error) {
    return jsonResponse({
      success: false,
      error: String(error && error.message ? error.message : error)
    });
  }
}

function routeGet(e) {
  const action = String(e.parameter.action || "");

  if (action === "config") {
    return jsonResponse(RANGE_CONFIG);
  }

  if (action === "members") {
    if (!validApiKey(e)) {
      return jsonResponse({ success: false, error: "Unauthorized" });
    }
    return getMembers();
  }

  if (action === "active") {
    if (!validApiKey(e)) {
      return jsonResponse({ success: false, error: "Unauthorized" });
    }
    return jsonResponse(
      getActiveArray(e.parameter.range || "")
    );
  }

  if (action === "memberStatus") {
    if (!validApiKey(e)) {
      return jsonResponse({ success: false, error: "Unauthorized" });
    }
    return jsonResponse(
      getMemberStatus(e.parameter.memberId)
    );
  }

  if (action === "ackForgotten") {
    if (!validApiKey(e)) {
      return jsonResponse({ success: false, error: "Unauthorized" });
    }
    return jsonResponse(acknowledgeForgottenCheckout(e.parameter.eventId, e.parameter.memberId));
  }

  if (action === "rangeStatus") {
    return jsonResponse(getRangeStatus(e.parameter.range || ""));
  }

  if (action === "enforceRange") {
    if (!validApiKey(e)) {
      return jsonResponse({ success: false, error: "Unauthorized" });
    }
    return jsonResponse(enforceRangeRulesForRange(e.parameter.range || ""));
  }

  if (action === "heartbeat") {
    if (!validApiKey(e)) {
      return jsonResponse({ success: false, error: "Unauthorized" });
    }
    return jsonResponse(recordTabletHeartbeat(e));
  }

  if (action === "waiverLookup") {
    return jsonResponse(
      lookupWaiver(e.parameter.waiverId)
    );
  }

  if (action === "waiverStatus") {
    return jsonpOrJson(
      getWaiverUploadStatus(e.parameter.groupId),
      e.parameter.cb
    );
  }

  if (action === "submit") {
    if (!validApiKey(e)) {
      return jsonResponse({ success: false, error: "Unauthorized" });
    }
    return handleSubmit(e);
  }

  if (action === "dashboard") {
    if (!validApiKey(e)) {
      return unauthorizedResponse(e.parameter.cb);
    }

    const days = parseInt(e.parameter.days || "1", 10);

    return jsonpOrJson(
      getDashboard(days),
      e.parameter.cb
    );
  }

  if (action === "adminActive") {
    if (!validApiKey(e)) {
      return unauthorizedResponse(e.parameter.cb);
    }

    return jsonpOrJson(
      getActiveGroupedByRange(),
      e.parameter.cb
    );
  }

  if (action === "adminForceCheckout") {
    if (!validApiKey(e)) {
      return unauthorizedResponse(e.parameter.cb);
    }

    return jsonpOrJson(
      adminForceCheckout(e.parameter.memberId),
      e.parameter.cb
    );
  }

  if (action === "adminClearRange") {
    if (!validApiKey(e)) {
      return unauthorizedResponse(e.parameter.cb);
    }

    return jsonpOrJson(
      adminClearRange(e.parameter.range),
      e.parameter.cb
    );
  }

  if (action === "adminClearAll") {
    if (!validApiKey(e)) {
      return unauthorizedResponse(e.parameter.cb);
    }

    return jsonpOrJson(
      adminClearAll(),
      e.parameter.cb
    );
  }

  if (action === "adminBackupNow") {
    if (!validApiKey(e)) {
      return unauthorizedResponse(e.parameter.cb);
    }

    backupSheet();

    return jsonpOrJson(
      { success: true },
      e.parameter.cb
    );
  }

  if (action === "adminLogs") {
    if (!validApiKey(e)) {
      return unauthorizedResponse(e.parameter.cb);
    }

    return jsonpOrJson(
      adminLogs(100),
      e.parameter.cb
    );
  }

  return ContentService.createTextOutput("Invalid");
}

// ============================================================
// POST ROUTER — ENCRYPTED WAIVER UPLOAD
// ============================================================
function doPost(e) {
  const lock = LockService.getScriptLock();

  try {
    lock.waitLock(30000);
  } catch (lockError) {
    return jsonResponse({
      success: false,
      error: "Server busy, please retry"
    });
  }

  try {
    const payloadText =
      (e.parameter && e.parameter.payload) ||
      (e.postData && e.postData.contents) ||
      "";

    if (!payloadText) {
      return jsonResponse({
        success: false,
        error: "Missing payload"
      });
    }

    const payload =
      typeof payloadText === "string"
        ? JSON.parse(payloadText)
        : payloadText;

    const result = saveEncryptedWaiverPackage(payload);

    return jsonResponse(result);

  } catch (error) {
    return jsonResponse({
      success: false,
      error: String(error && error.message
        ? error.message
        : error)
    });
  } finally {
    lock.releaseLock();
  }
}

// ============================================================
// RESPONSE HELPERS
// ============================================================
function validApiKey(e) {
  return String(e.parameter.key || "") === API_KEY;
}

function jsonResponse(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

function jsonpOrJson(data, cb) {
  // Only accept a plain JavaScript identifier / dotted path as a callback
  // name. Anything else falls back to plain JSON.
  if (cb && /^[A-Za-z_$][\w$.]*$/.test(String(cb))) {
    return ContentService
      .createTextOutput(
        cb + "(" + JSON.stringify(data) + ")"
      )
      .setMimeType(
        ContentService.MimeType.JAVASCRIPT
      );
  }

  return jsonResponse(data);
}

function unauthorizedResponse(cb) {
  return jsonpOrJson({
    success: false,
    error: "Unauthorized"
  }, cb);
}

function getRangeName(rangeId) {
  const id = String(rangeId || "").toLowerCase();
  return RANGE_CONFIG[id]
    ? RANGE_CONFIG[id].name
    : id;
}

// ============================================================
// MEMBER LIST
// ============================================================
function getMembers() {
  const sheet = SpreadsheetApp
    .getActiveSpreadsheet()
    .getSheetByName(MEMBERS_SHEET);

  const lastRow = sheet.getLastRow();

  if (lastRow < 2) {
    return jsonResponse([]);
  }

  const values = sheet
    .getRange(2, 1, lastRow - 1, 1)
    .getValues();

  const members = values
    .map(row => String(row[0]).trim())
    .filter(value => value !== "");

  return jsonResponse(members);
}

// ============================================================
// ACTIVE SESSION HELPERS
// ============================================================

// Returns the most recent `count` data rows of the Checkins sheet
// (oldest first, header excluded).
function getRecentCheckinRows(count) {
  const sheet = SpreadsheetApp
    .getActiveSpreadsheet()
    .getSheetByName(SHEET_NAME);

  const lastRow = sheet.getLastRow();

  if (lastRow < 2) return [];

  const firstRow = Math.max(
    2,
    lastRow - Math.max(1, count || RECENT_ROWS) + 1
  );

  const columns = Math.min(14, sheet.getMaxColumns());

  return sheet
    .getRange(firstRow, 1, lastRow - firstRow + 1, columns)
    .getValues();
}

function getOpenSessions() {
  const data = getRecentCheckinRows(RECENT_ROWS);
  const sessions = {};

  for (let i = 0; i < data.length; i++) {
    const timestamp = data[i][0];
    const range = String(data[i][1] || "")
      .toLowerCase();
    const member = String(data[i][2] || "")
      .trim();
    const positions = String(data[i][3] || "");
    const action = String(data[i][5] || "");
    const session = String(data[i][6] || "");

    if (!session) continue;

    if (!sessions[session]) {
      sessions[session] = {
        session,
        timestamp,
        range,
        member,
        positions,
        open: false
      };
    }

    if (action === "IN") {
      sessions[session].open = true;
      sessions[session].timestamp = timestamp;
      sessions[session].range = range;
      sessions[session].member = member;
      sessions[session].positions = positions;
    }

    if (action === "OUT") {
      sessions[session].open = false;
    }
  }

  return Object
    .values(sessions)
    .filter(session => session.open);
}

function getActiveArray(rangeId) {
  const range = String(rangeId || "")
    .toLowerCase();

  return getOpenSessions()
    .filter(session =>
      !range || session.range === range
    )
    .map(session => session.member);
}

function getActiveGroupedByRange() {
  const grouped = {};

  Object.keys(RANGE_CONFIG).forEach(id => {
    grouped[id] = {
      id,
      name: RANGE_CONFIG[id].name,
      active: []
    };
  });

  getOpenSessions().forEach(session => {
    if (!grouped[session.range]) {
      grouped[session.range] = {
        id: session.range,
        name: getRangeName(session.range),
        active: []
      };
    }

    grouped[session.range].active.push({
      member: session.member,
      session: session.session,
      positions: session.positions
    });
  });

  return grouped;
}

function findOpenSessionForMember(memberId) {
  const id = String(memberId || "").trim();

  return getOpenSessions()
    .find(session => session.member === id) || null;
}

function getMemberStatus(memberId) {
  const id = String(memberId || "").trim();
  const open = findOpenSessionForMember(id);
  const forgottenWarning = getNextUnacknowledgedForgottenCheckout(id);

  const result = {
    active: false,
    forgottenWarning
  };

  if (!open) return result;

  result.active = true;
  result.range = open.range;
  result.rangeName = getRangeName(open.range);
  result.member = open.member;
  return result;
}

function getNextUnacknowledgedForgottenCheckout(memberId) {
  const sheet = ensureSheetWithHeaders(FORGOTTEN_SHEET, [
    "EventID", "MemberID", "Range", "CheckInTime",
    "AutoCheckoutTime", "Reason", "Acknowledged", "AcknowledgedAt"
  ]);
  const data = sheet.getDataRange().getValues();

  for (let i = 1; i < data.length; i++) {
    const id = String(data[i][1] || "").trim();
    const acknowledged = normalizeBoolean(data[i][6]);
    if (id === memberId && !acknowledged) {
      return {
        eventId: String(data[i][0] || ""),
        memberId: id,
        range: String(data[i][2] || ""),
        rangeName: getRangeName(data[i][2]),
        checkInTime: toIsoString(data[i][3]),
        autoCheckoutTime: toIsoString(data[i][4]),
        reason: String(data[i][5] || "")
      };
    }
  }
  return null;
}

function acknowledgeForgottenCheckout(eventId, memberId) {
  const event = String(eventId || "").trim();
  const member = String(memberId || "").trim();
  if (!event || !member) return { success: false, error: "Missing event or member ID" };

  const sheet = ensureSheetWithHeaders(FORGOTTEN_SHEET, [
    "EventID", "MemberID", "Range", "CheckInTime",
    "AutoCheckoutTime", "Reason", "Acknowledged", "AcknowledgedAt"
  ]);
  const data = sheet.getDataRange().getValues();

  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0] || "") === event && String(data[i][1] || "").trim() === member) {
      sheet.getRange(i + 1, 7).setValue(true);
      sheet.getRange(i + 1, 8).setValue(new Date());
      return { success: true };
    }
  }
  return { success: false, error: "Forgotten checkout record not found" };
}

function toIsoString(value) {
  if (!value) return "";
  const date = value instanceof Date ? value : new Date(value);
  return isNaN(date.getTime()) ? "" : date.toISOString();
}

// ============================================================
// CHECK-IN / CHECKOUT
// ============================================================

// Offline replays carry the original time in the "queued" parameter.
// Use it as the row timestamp when it is a valid, non-future time.
function parseQueuedTime(queued) {
  if (!queued) return new Date();

  const date = new Date(String(queued));

  if (
    isNaN(date.getTime()) ||
    date.getTime() > Date.now() + 60000
  ) {
    return new Date();
  }

  return date;
}

function handleSubmit(e) {
  const lock = LockService.getScriptLock();

  try {
    lock.waitLock(10000);
  } catch (lockError) {
    // "busy" tells the kiosk to retry later instead of discarding the item.
    return jsonResponse({
      success: false,
      busy: true,
      error: "Server busy"
    });
  }

  try {
    const sheet = SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName(SHEET_NAME);

    const range = String(
      e.parameter.range || ""
    ).toLowerCase();

    const memberId = String(
      e.parameter.memberId || ""
    ).trim();

    const positions =
      e.parameter.positions || "";

    const supplies =
      e.parameter.supplies || "";

    const action =
      e.parameter.type || "";

    const queued =
      e.parameter.queued || "";

    const clientId =
      e.parameter.clientId || "";

    const hasGuests =
      normalizeBoolean(e.parameter.hasGuests);

    const guestCount =
      Math.max(
        0,
        parseInt(e.parameter.guestCount || "0", 10)
        || 0
      );

    const guestGroupId =
      e.parameter.guestGroupId || "";

    const waiverIds =
      e.parameter.waiverIds || "";

    const waiverUploaded =
      normalizeBoolean(e.parameter.waiverUploaded);

    if (!memberId || !action) {
      return jsonResponse({
        success: false,
        error: "Missing data"
      });
    }

    if (
      clientId &&
      clientSubmissionExists(clientId)
    ) {
      return jsonResponse({
        success: true,
        duplicate: true
      });
    }

    if (
      action === "IN" &&
      !RANGE_CONFIG[range]
    ) {
      return jsonResponse({
        success: false,
        error: "Invalid range"
      });
    }

    // Original event time (replay time only if the item was not queued).
    const eventTime = parseQueuedTime(queued);

    // ------------------------------------------------------------
    // CHECK OUT
    // ------------------------------------------------------------
    if (action === "OUT") {
      const open = findOpenSessionForMember(memberId);

      if (!open) {
        // Offline checkouts can be replayed long after the member was
        // already checked out by another successful request/admin action.
        // Treat that queued replay as a successful no-op so it cannot
        // permanently block every later item in the tablet queue.
        if (queued) {
          return jsonResponse({
            success: true,
            noOp: true,
            reason: "Already checked out"
          });
        }

        return jsonResponse({
          success: false,
          error: "Not checked in"
        });
      }

      appendCheckoutRow(
        open.range,
        memberId,
        open.session,
        queued,
        clientId,
        eventTime
      );

      return jsonResponse({ success: true });
    }

    // ------------------------------------------------------------
    // CHECK IN
    // ------------------------------------------------------------
    let autoCheckout = null;
    let historicalOnly = false;

    if (action === "IN") {
      const open =
        findOpenSessionForMember(memberId);

      if (open) {
        if (open.range === range) {
          // Same range, already open.
          // A queued replay of a check-in that already landed is harmless.
          if (queued) {
            return jsonResponse({
              success: true,
              duplicate: true,
              reason: "Already checked in"
            });
          }

          return jsonResponse({
            success: false,
            error: "Already checked in"
          });
        }

        if (
          queued &&
          new Date(open.timestamp).getTime() >
            eventTime.getTime()
        ) {
          // This replayed check-in is OLDER than the session that is
          // currently open elsewhere. Record it as a finished visit and
          // leave the newer open session alone.
          historicalOnly = true;
        } else {
          // Different range: auto-checkout from the old range, as usual.
          appendCheckoutRow(
            open.range,
            memberId,
            open.session,
            queued,
            clientId
              ? clientId + "_auto_out"
              : "",
            new Date()
          );

          autoCheckout = {
            range: open.range,
            rangeName: getRangeName(open.range)
          };
        }
      }
    }

    const sessionId = Utilities.getUuid();

    sheet.appendRow([
      eventTime,                  // Timestamp (original time if replayed)
      range,                      // Range
      memberId,                   // MemberID
      positions,                  // Positions
      supplies,                   // Supplies
      action,                     // Action
      sessionId,                  // SessionID
      queued,                     // Queued
      clientId,                   // ClientID
      hasGuests,                  // HasGuests
      guestCount,                 // GuestCount
      guestGroupId,               // GuestGroupID
      waiverIds,                  // WaiverIDs
      waiverUploaded              // WaiverUploaded
    ]);

    if (historicalOnly) {
      appendCheckoutRow(
        range,
        memberId,
        sessionId,
        queued,
        clientId
          ? clientId + "_hist_out"
          : "",
        eventTime
      );
    }

    return jsonResponse({
      success: true,
      sessionId,
      autoCheckout
    });

  } finally {
    lock.releaseLock();
  }
}

function appendCheckoutRow(
  range,
  memberId,
  sessionId,
  queued,
  clientId,
  when
) {
  const sheet = SpreadsheetApp
    .getActiveSpreadsheet()
    .getSheetByName(SHEET_NAME);

  sheet.appendRow([
    when || new Date(),
    range,
    memberId,
    "",
    "",
    "OUT",
    sessionId,
    queued || "",
    clientId || "",
    false,
    0,
    "",
    "",
    false
  ]);
}

function normalizeBoolean(value) {
  const text = String(value || "")
    .toLowerCase();

  return (
    text === "true" ||
    text === "1" ||
    text === "yes"
  );
}

function clientSubmissionExists(clientId) {
  const data = getRecentCheckinRows(RECENT_ROWS);
  const id = String(clientId);

  for (let i = 0; i < data.length; i++) {
    if (String(data[i][8] || "") === id) {
      return true;
    }
  }

  return false;
}

// ============================================================
// WAIVER LOOKUP
// ============================================================
function lookupWaiver(waiverId) {
  const id = String(waiverId || "")
    .toUpperCase()
    .trim();

  if (!id) {
    return {
      valid: false
    };
  }

  const sheet = SpreadsheetApp
    .getActiveSpreadsheet()
    .getSheetByName(GUEST_WAIVERS_SHEET);

  const data = sheet.getDataRange().getValues();

  for (let i = 1; i < data.length; i++) {
    if (
      String(data[i][1] || "")
        .toUpperCase()
        .trim() === id &&
      String(data[i][11] || "") === "Uploaded"
    ) {
      return {
        valid: true,
        waiverId: id,
        version: String(data[i][6] || "")
      };
    }
  }

  return {
    valid: false
  };
}

function getWaiverUploadStatus(groupId) {
  const id = String(groupId || "").trim();

  if (!id) {
    return {
      uploaded: false,
      error: "Missing group ID"
    };
  }

  const sheet = SpreadsheetApp
    .getActiveSpreadsheet()
    .getSheetByName(GUEST_WAIVERS_SHEET);

  const data = sheet.getDataRange().getValues();

  let matches = 0;
  let uploaded = 0;
  const waiverIds = [];

  for (let i = 1; i < data.length; i++) {
    if (
      String(data[i][2] || "") === id
    ) {
      matches++;

      waiverIds.push(
        String(data[i][1] || "")
      );

      if (
        String(data[i][11] || "") ===
        "Uploaded"
      ) {
        uploaded++;
      }
    }
  }

  return {
    uploaded:
      matches > 0 &&
      uploaded === matches,

    records: matches,
    waiverIds
  };
}

// ============================================================
// ENCRYPTED WAIVER STORAGE
// ============================================================
function saveEncryptedWaiverPackage(payload) {
  validateWaiverPayload(payload);

  const groupId = String(
    payload.guestGroupId
  ).trim();

  if (guestGroupAlreadyUploaded(groupId)) {
    return {
      success: true,
      duplicate: true,
      guestGroupId: groupId
    };
  }

  const folder = getOrCreateWaiverFolder();

  const year = String(
    new Date().getFullYear()
  );

  const yearFolder =
    getOrCreateChildFolder(folder, year);

  const safeGroupId =
    groupId.replace(
      /[^A-Za-z0-9_-]/g,
      "_"
    );

  const filename =
    safeGroupId +
    "_" +
    String(payload.waiverVersion || "unknown")
      .replace(/[^A-Za-z0-9_-]/g, "_") +
    ".nfga-waiverpkg.json";

  const storedPackage = {
    format: "NFGA-WAIVER-PACKAGE-1",
    createdUtc:
      new Date().toISOString(),

    guestGroupId:
      payload.guestGroupId,

    waiverIds:
      payload.waiverIds,

    sponsorMemberId:
      payload.sponsorMemberId,

    range:
      payload.range,

    guestCount:
      payload.guestCount,

    waiverVersion:
      payload.waiverVersion,

    encryptedKey:
      payload.encryptedKey,

    iv:
      payload.iv,

    hash:
      payload.hash,

    ciphertext:
      payload.ciphertext
  };

  yearFolder.createFile(
    Utilities.newBlob(
      JSON.stringify(storedPackage),
      "application/json",
      filename
    )
  );

  appendGuestWaiverRows(
    payload,
    filename
  );

  markCheckinWaiverUploaded(
    groupId,
    payload.waiverIds
  );

  return {
    success: true,
    guestGroupId: groupId,
    filename
  };
}

function validateWaiverPayload(payload) {
  const required = [
    "guestGroupId",
    "waiverIds",
    "sponsorMemberId",
    "range",
    "guestCount",
    "waiverVersion",
    "encryptedKey",
    "iv",
    "hash",
    "ciphertext"
  ];

  required.forEach(field => {
    if (
      payload[field] === undefined ||
      payload[field] === null ||
      payload[field] === ""
    ) {
      throw new Error(
        "Missing waiver field: " + field
      );
    }
  });

  if (!Array.isArray(payload.waiverIds)) {
    throw new Error(
      "waiverIds must be an array"
    );
  }

  if (
    payload.waiverIds.length !==
    Number(payload.guestCount)
  ) {
    throw new Error(
      "Waiver ID count does not match guest count"
    );
  }

  if (!RANGE_CONFIG[
    String(payload.range).toLowerCase()
  ]) {
    throw new Error("Invalid range");
  }
}

