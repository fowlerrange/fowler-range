// TABLET HEALTH
// ============================================================
function recordTabletHeartbeat(e) {
  const range = String(e.parameter.range || "").toLowerCase().trim();
  if (!RANGE_CONFIG[range]) return { success: false, error: "Invalid range" };

  const sheet = ensureSheetWithHeaders(TABLET_HEALTH_SHEET, [
    "Range", "RangeName", "FirstSeen", "LastSeen", "Online", "CheckinQueue", "WaiverQueue", "KioskVersion", "UserAgent"
  ]);
  const now = new Date();
  const data = sheet.getDataRange().getValues();
  let targetRow = 0;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0] || "").toLowerCase() === range) { targetRow = i + 1; break; }
  }

  const online = normalizeBoolean(e.parameter.online);
  const checkinQueue = Math.max(0, parseInt(e.parameter.checkinQueue || "0", 10) || 0);
  const waiverQueue = Math.max(0, parseInt(e.parameter.waiverQueue || "0", 10) || 0);
  const version = String(e.parameter.version || "");
  const userAgent = String(e.parameter.userAgent || "");

  const row = [range, getRangeName(range), targetRow ? (data[targetRow - 1][2] || now) : now, now, online, checkinQueue, waiverQueue, version, userAgent];
  if (!targetRow) sheet.appendRow(row);
  else sheet.getRange(targetRow, 1, 1, 9).setValues([row]);
  return { success: true, serverTime: now.toISOString(), kioskVersion: LATEST_KIOSK_VERSION };
}

function sendMorningHealthAlerts() {
  const healthSheet = ensureSheetWithHeaders(TABLET_HEALTH_SHEET, [
    "Range", "RangeName", "FirstSeen", "LastSeen", "Online", "CheckinQueue", "WaiverQueue", "KioskVersion", "UserAgent"
  ]);
  const recipientsSheet = ensureSheetWithHeaders(ALERT_RECIPIENTS_SHEET, ["Range", "Email", "Enabled"]);
  const healthData = healthSheet.getDataRange().getValues();
  if (healthData.length < 2) return;

  const cutoff = getPreviousLocalTenPm();
  const issues = [];
  for (let i = 1; i < healthData.length; i++) {
    const range = String(healthData[i][0] || "").toLowerCase().trim();
    if (!range) continue;
    const lastSeen = new Date(healthData[i][3]);
    const checkinQueue = Number(healthData[i][5] || 0);
    const waiverQueue = Number(healthData[i][6] || 0);
    const issue = { range, rangeName: healthData[i][1] || getRangeName(range), lastSeen, checkinQueue, waiverQueue, reasons: [] };
    if (isNaN(lastSeen.getTime()) || lastSeen.getTime() < cutoff.getTime()) issue.reasons.push("No heartbeat since 10:00 PM last night");
    if (checkinQueue > 0) issue.reasons.push(checkinQueue + " pending check-in/check-out upload" + (checkinQueue === 1 ? "" : "s"));
    if (waiverQueue > 0) issue.reasons.push(waiverQueue + " pending waiver upload" + (waiverQueue === 1 ? "" : "s"));
    if (issue.reasons.length) issues.push(issue);
  }
  if (!issues.length) return;

  const recipients = recipientsSheet.getDataRange().getValues();
  const byEmail = {};
  for (let i = 1; i < recipients.length; i++) {
    const range = String(recipients[i][0] || "").toLowerCase().trim();
    const email = String(recipients[i][1] || "").trim();
    const enabled = recipients[i][2] === "" || normalizeBoolean(recipients[i][2]);
    if (!email || !enabled) continue;
    const matching = issues.filter(issue => range === "all" || range === issue.range);
    if (!matching.length) continue;
    if (!byEmail[email]) byEmail[email] = [];
    matching.forEach(issue => {
      if (!byEmail[email].some(existing => existing.range === issue.range)) byEmail[email].push(issue);
    });
  }

  Object.keys(byEmail).forEach(email => {
    MailApp.sendEmail({ to: email, subject: "NFGA Range Tablet Health Alert", body: buildHealthAlertEmail(byEmail[email], cutoff) });
  });
}

function buildHealthAlertEmail(issues, cutoff) {
  const lines = ["The following range tablet issues need attention:", ""];
  issues.forEach(issue => {
    lines.push(issue.rangeName);
    lines.push("Last seen: " + (isNaN(issue.lastSeen.getTime()) ? "Never" : Utilities.formatDate(issue.lastSeen, RANGE_TIME_ZONE, "MMM d, yyyy h:mm a")));
    issue.reasons.forEach(reason => lines.push("- " + reason));
    lines.push("");
  });
  lines.push("Health cutoff: " + Utilities.formatDate(cutoff, RANGE_TIME_ZONE, "MMM d, yyyy h:mm a"));
  return lines.join("\n");
}

function getPreviousLocalTenPm() {
  const now = new Date();
  const parts = getLocalDateTimeParts(now);
  const localTodayUtc = Date.UTC(parts.year, parts.month - 1, parts.day);
  const yesterday = new Date(localTodayUtc - 86400000);
  return localWallClockToUtc(yesterday.getUTCFullYear(), yesterday.getUTCMonth() + 1, yesterday.getUTCDate(), 22, 0);
}

function localWallClockToUtc(year, month, day, hour, minute) {
  let guess = new Date(Date.UTC(year, month - 1, day, hour, minute));
  for (let i = 0; i < 3; i++) {
    const formatted = Utilities.formatDate(guess, RANGE_TIME_ZONE, "yyyy,MM,dd,HH,mm").split(",").map(Number);
    const desired = Date.UTC(year, month - 1, day, hour, minute);
    const actual = Date.UTC(formatted[0], formatted[1] - 1, formatted[2], formatted[3], formatted[4]);
    guess = new Date(guess.getTime() + (desired - actual));
  }
  return guess;
}

